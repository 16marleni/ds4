
@{
    ViewBag.Title = "Index";
}

<div class="row">
    <form id="frm">
        <div class="col-lg-6 col-lg-offset-3">
            Usuario
            <input type="text" name="user" />
            Password
            <input type="password" name="pass" />
            <input type="submit" class="btn btn-success" value="Entrar" />
        </div>
    </form>
</div>

@section scripts
 {
    <script>
       $(document).ready(function () {
             $("#frm").submit(function (e) {
                 e.preventDefault(); // evita que el formulario se envíe normalmente
                 let url = "@Url.Content("~/Access/Enter")"; // URL de tu acción
                 let parametros = $(this).serialize(); // serializa los datos del formulario

                 $.post(url, parametros, function (data){
                     if (data == "1") {
                        document.location.href = "@Url.Content("~/")"; // redirige a la página principal
                     }
                     else {
                        alert(data); // muestra el error recibido
                     }
                 })
             })
       })
    </script>
 }
