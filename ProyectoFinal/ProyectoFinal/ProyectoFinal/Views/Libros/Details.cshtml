@model ProyectoFinal.Models.Libro

@{
    ViewBag.Title = "Detalles del Libro";
}


<div class="container" style="max-width:600px; margin:auto;">
    <h4 style="text-align:center; margin-bottom:20px;">Detalles del libro "@Model.Titulo"</h4>

    <table class="table table-bordered table-striped">
        <tbody>
            <tr>
                <th style="width:40%;">Título</th>
                <td style="text-align:center;">@Model.Titulo</td>
            </tr>
            <tr>
                <th>Autor</th>
                <td style="text-align:center;">@Model.Autor</td>
            </tr>
            <tr>
                <th>Categoría</th>
                <td style="text-align:center;">@Model.Categoria</td>
            </tr>
            <tr>
                <th>Disponible</th>
                <td style="text-align:center;">
                    @if (Model.Disponible)
                    {
                        <i class="bi bi-check-lg text-success"></i>
                    }
                    else
                    {
                        <i class="bi bi-x-lg text-danger"></i>
                    }
                </td>
            </tr>
            <tr>
                <th>Cantidad</th>
                <td style="text-align:center;">@Model.Cantidad
            </td>
            <tr>
                <th>Fecha Registro</th>
                <td style="text-align:center;">@Model.FechaRegistro.ToString("dd/MM/yyyy")</td>
            </tr>
        </tbody>
    </table>

    <div style="text-align:center; margin-top:20px;">
        @Html.ActionLink("Editar", "Edit", new { id = Model.LibroId }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Volver a Lista de libros", "Index", null, new { @class = "btn btn-secondary" })
    </div>
</div>

<!--Enlace para usar los iconos de Bootstrap-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

