@model IEnumerable<ProyectoFinal.Models.Usuario>

@{
    ViewBag.Title = "Lista de usuarios";
}

<!-- Botón Agregar Nuevo -->
<p style="text-align:right;">
    @Html.ActionLink("Agregar nuevo usuario", "Create", null, new { @class = "btn btn-success" })
</p>

<h2 style="text-align:left;">Lista de usuarios</h2>

<!-- Mensajes -->
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success" style="text-align:center;">
        @TempData["MensajeExito"]
    </div>
}

@if (TempData["MensajeAdvertencia"] != null)
{
    <div class="alert alert-warning" style="text-align:center;">
        @TempData["MensajeAdvertencia"]
    </div>
}

@if (TempData["MensajeInfo"] != null)
{
    <div class="alert alert-info" style="text-align:center;">
        @TempData["MensajeInfo"]
    </div>
}

<!-- Tabla de usuarios -->
<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr style="text-align:center;">
            <th>Nombre</th>
            <th>Correo</th>
            <th>Tipo de Usuario</th>
            <th>Fecha Registro</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="text-align:center;">@item.Nombre</td>
                <td style="text-align:center;">@item.Correo</td>
                <td style="text-align:center;">@item.TipoUsuario</td>
                <td style="text-align:center;">@item.FechaRegistro.ToString("dd/MM/yyyy")</td>
                <td style="text-align:center;">
                    @Html.ActionLink("Editar", "Edit", new { id = item.UsuarioId }, new { @class = "btn btn-sm btn-primary" })
                    @Html.ActionLink("Detalles", "Details", new { id = item.UsuarioId }, new { @class = "btn btn-sm btn-info" })
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.UsuarioId }, new { @class = "btn btn-sm btn-danger" })
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Botón de regresar a inicio -->
<p>
    @Html.ActionLink("Volver a Inicio", "Index", "Inicio", null, new { @class = "btn btn-primary" })
</p>



