@model ProyectoFinal.Models.Usuario

@{
    ViewBag.Title = "Eliminar Usuario";
}

<div class="container" style="max-width:800px; margin:auto;">
    <h4 style="text-align:center; margin-bottom:20px;">¿Está seguro que desea eliminar este usuario?</h4>

    <!-- Tabla con los datos del usuario -->
    <table class="table table-bordered table-striped">
        <thead class="thead-dark">
            <tr style="text-align:center;">
                <th>Nombre</th>
                <th>Correo</th>
                <th>Tipo de Usuario</th>
            </tr>
        </thead>
        <tbody>
            <tr style="text-align:center;">
                <td>@Model.Nombre</td>
                <td>@Model.Correo</td>
                <td>@Model.TipoUsuario</td>
            </tr>
        </tbody>
    </table>

    <!-- Botones -->
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div style="text-align:center; margin-top:20px;">
            <input type="submit" value="Eliminar" class="btn btn-danger" />
            @Html.ActionLink("Volver a Lista de usuarios", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    }
</div>


