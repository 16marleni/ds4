@model IEnumerable<ProyectoFinal.Models.Resenas>

@{
    ViewBag.Title = "Reporte de Reseñas";
    var fechaReporte = DateTime.Now.ToString("dd/MM/yyyy");
    bool esPDF = ViewBag.EsPDF != null && (bool)ViewBag.EsPDF;
}

<div style="text-align:center; margin-bottom:20px;">
    <img src="~/Content/imagenes/logo.png" alt="Logo Biblioteca" style="height:100px;" />
    <h1>BIBLIOTECA ROCKET</h1>
    <h3>Reporte de Reseñas</h3>
    <p>Fecha del reporte: @fechaReporte</p>
</div>

@if (!esPDF)
{
    <p style="text-align:right;">
        @Html.ActionLink("Agregar reseña", "Create", null, new { @class = "btn btn-success", style = "margin-right:5px;" })
        @Html.ActionLink("Exportar a PDF", "ExportarPDF", null, new { @class = "btn btn-danger" })
    </p>
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success text-center">@TempData["MensajeExito"]</div>
}

@if (TempData["MensajeAdvertencia"] != null)
{
    <div class="alert alert-warning text-center">@TempData["MensajeAdvertencia"]</div>
}

<div class="alert alert-secondary text-center" style="margin-bottom:15px;">
    <strong>Calificación:</strong>
    <span style="margin-left:10px;"><strong>1</strong> = Muy malo</span> |
    <span style="margin-left:5px;"><strong>2</strong> = Malo</span> |
    <span style="margin-left:5px;"><strong>3</strong> = Regular</span> |
    <span style="margin-left:5px;"><strong>4</strong> = Bueno</span> |
    <span style="margin-left:5px;"><strong>5</strong> = Excelente</span>
</div>

<table class="table table-bordered table-striped">
    <thead class="thead-dark">
        <tr style="text-align:center;">
            <th>Usuario</th>
            <th>Libro</th>
            <th>Comentario</th>
            <th>Calificación</th>
            <th>Fecha</th>
            @if (!esPDF)
            {
                <th>Acciones</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="text-align:center;">@item.Usuario</td>
                <td style="text-align:center;">@item.Libro</td>
                <td style="text-align:center;">@item.Comentario</td>
                <td style="text-align:center;">@item.Calificacion</td>
                <td style="text-align:center;">@item.Fecha.ToString("dd/MM/yyyy")</td>
                @if (!esPDF)
                {
                    <td style="text-align:center;">
                        @Html.ActionLink("Detalles", "Details", new { id = item.ResenaId }, new { @class = "btn btn-info btn-sm" })
                        @Html.ActionLink("Eliminar", "Delete", new { id = item.ResenaId }, new { @class = "btn btn-danger btn-sm", style = "margin-left:3px;" })
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (!esPDF)
{
    <p>
        @Html.ActionLink("Volver a Inicio", "Index", "Inicio", null, new { @class = "btn btn-primary" })
    </p>
}
