@model ProyectoFinal.Models.Prestamos

@{
    ViewBag.Title = "Registrar Préstamo";
}

<h2 style="text-align:left;">Registrar préstamo</h2>

<!-- Leyenda de calificaciones -->
<div class="alert alert-secondary text-center" style="margin-bottom:15px;">
    <strong>ATENCIÓN: Los libros que no aparezcan en la lista desplegable no mantienen unidades disponibles.</strong>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="max-width:600px; text-align:left;">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- Usuario -->
        <div class="form-group">
            @Html.Label("Usuario")
            @Html.DropDownListFor(
                model => model.UsuarioId,
                (SelectList)ViewBag.Usuarios,
                "Seleccione un usuario",
                new { @class = "form-control" }
            )
            @Html.ValidationMessageFor(model => model.UsuarioId, "", new { @class = "text-danger" })
        </div>

        <!-- Libro -->
        <div class="form-group">
            @Html.Label("Libro")
            @Html.DropDownListFor(
                model => model.LibroId,
                (SelectList)ViewBag.Libros,
                "Seleccione un libro",
                new { @class = "form-control" }
            )
            @Html.ValidationMessageFor(model => model.LibroId, "", new { @class = "text-danger" })
        </div>

        <!-- Botones -->
        <div class="form-group" style="margin-top:20px;">
            <input type="submit" value="Registrar préstamo" class="btn btn-primary" />
            @Html.ActionLink("Volver a Lista de préstamos", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
